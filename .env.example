# Hosted accounts, cookbooks and photos use your own Supabase project.
# Copy this file to .env for local connected development; never commit .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Legacy projects can use SUPABASE_ANON_KEY instead of SUPABASE_PUBLISHABLE_KEY.
# Do not use the secret/service-role key: the app relies on per-user RLS.

# Optional local server settings.
# PORT=3000
# HOST=127.0.0.1
