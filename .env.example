# Hosted accounts, cookbooks and photos use your own Supabase (self-hosted or supabase.com).
# Copy this file to .env for local connected development; never commit .env.
SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=your_anon_key
# supabase.com projects can use SUPABASE_PUBLISHABLE_KEY (sb_publishable_…) instead.
# Do not use the secret/service-role key: the app relies on per-user RLS.

# Optional local server settings.
# PORT=3000
# HOST=127.0.0.1

# Only for a supabase.com Free project, which pauses when idle: a scheduler sends
# this as a bearer token to /api/cron/keepalive. Not needed when self-hosting.
# CRON_SECRET=a_long_random_string
